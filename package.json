{
  "name": "lemonade-game",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based multiplayer Lemonade Game.",
  "type": "module",
  "engines": {
    "node": ">=20.16.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:client": "npm run dev --workspace @lemonade-game/client",
    "dev:server": "npm run dev --workspace @lemonade-game/server",
    "lint": "npm run typecheck",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "vite": "6.4.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
